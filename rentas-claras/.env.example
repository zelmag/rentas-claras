# RentasClaras Environment Configuration
# ======================================
# Copy this file to .env and fill in your values

# =============================================================================
# WhatsApp Cloud API (Meta)
# =============================================================================
# Get these from https://developers.facebook.com/apps → Your App → WhatsApp → API Setup
# See docs/SETUP_WHATSAPP_API.md for detailed instructions

# Your WhatsApp Cloud API access token (starts with EAA...)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Phone Number ID (found in API Setup page)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Optional: Business Account ID (for template management)
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765

# Optional: Test phone number for development (your own number)
# Messages in TEST_MODE will go here instead of to tenants
WHATSAPP_TEST_PHONE=+521234567890

# =============================================================================
# Application Settings
# =============================================================================

# Security PIN for accessing the admin interface
# IMPORTANT: Change this to a unique 4-6 digit PIN
RENTASCLARAS_PIN=0000

# Set to 'true' during development, 'false' for production
# When true, messages go to WHATSAPP_TEST_PHONE instead of real tenants
TEST_MODE=true

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=false

# =============================================================================
# Database (Optional - defaults to SQLite)
# =============================================================================

# For PostgreSQL (production), uncomment and configure:
# DATABASE_URL=postgresql://user:password@localhost:5432/rentas_claras

# =============================================================================
# Future Integrations (not yet implemented)
# =============================================================================

# OpenAI for OCR and AI features
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Vision (fallback OCR)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
