# VueloDigno (Flask) Environment Configuration
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub - it contains secrets

# =============================================================================
# Resend API (for sending emails)
# =============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email sender address (must be from a verified domain in Resend)
FROM_EMAIL=reclamos@vuelodigno.com

# =============================================================================
# Demo Mode
# =============================================================================
# Email address for Demo Airline testing
DEMO_EMAIL=your-email@gmail.com

# =============================================================================
# Legacy (commented out, for reference)
# =============================================================================
# GOOGLE_API_KEY=your_google_api_key_here
# GMAIL_APP_PASSWORD=your_app_password_here
# GMAIL_ADDRESS=your_gmail@gmail.com
